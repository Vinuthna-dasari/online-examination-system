```gitignore
# Frontend dependencies and build files
frontend/node_modules/
frontend/dist/

# Backend generated files
backend/target/

# Local database files
backend/data/
backend/*.db
backend/*.mv.db
backend/*.trace.db

# Environment variables and secrets
.env
.env.*
!.env.example

# IDE and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db
backend/backend-error.txt
backend/error.txt